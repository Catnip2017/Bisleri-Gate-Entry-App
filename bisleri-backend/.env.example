# bisleri-backend/.env.example
# ================================================================
# Bisleri Gate Entry App — Backend Configuration
# ================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit the real .env to Git (it is in .gitignore)
# ================================================================


# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection details for your Bisleri_01 database

DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Bisleri_01


# ── Security / JWT ───────────────────────────────────────────────
# Used to sign and verify login tokens.
# Generate a strong key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then paste the output below — keep it secret, never share it.

SECRET_KEY=replace_this_with_a_long_random_secret_key

# JWT signing algorithm — do not change
ALGORITHM=HS256

# How long a login session stays valid (in minutes)
# 720 = 12 hours  |  1440 = 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=720


# ── Co Packer Feature ────────────────────────────────────────────
# Set to false to completely hide the Co Packer card from the app
COPACKER_FEATURE_ENABLED=true

# Absolute path on the server where captured images will be stored.
# The app creates sub-folders automatically:
#   {COPACKER_IMAGE_PATH}/{location}/{year}/{month}/{date}/{asset_model_id}/{sku_itemid}/
# Example (Linux server): /var/bisleri/copacker_images
# Example (Windows dev):  C:/bisleri/copacker_images
COPACKER_IMAGE_PATH=/path/to/images


# ── WatsonX OCR — llama-4-maverick ───────────────────────────────
# Obtain these from your IBM Cloud WatsonX AI project dashboard.
# Leave as "placeholder" during development — OCR will return null
# and the extracted_quantity field will be stored as null.

# Full inference endpoint URL for your WatsonX deployment
# Example: https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2023-05-29
WATSONX_API_URL=placeholder

# IBM Cloud API key (IAM key with WatsonX AI access)
WATSONX_API_KEY=placeholder

# Your WatsonX project ID (found in Project > Manage > General)
WATSONX_PROJECT_ID=placeholder
