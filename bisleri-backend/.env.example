# bisleri-backend/.env.example
# ================================================================
# Bisleri Gate Entry App — Backend Configuration
# ================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit the real .env to Git (it is in .gitignore)
# ================================================================


# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection details for your Bisleri_01 database

DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Bisleri_01


# ── Security / JWT ───────────────────────────────────────────────
# Used to sign and verify login tokens.
# Generate a strong key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then paste the output below — keep it secret, never share it.

SECRET_KEY=replace_this_with_a_long_random_secret_key

# JWT signing algorithm — do not change
ALGORITHM=HS256

# How long a login session stays valid (in minutes)
# 720 = 12 hours  |  1440 = 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── Vehicle/Load Dashboard (Bisleri_dashboard DB) ────────────────
# Separate historical/analytics database used by the dashboard's ETL and
# read endpoints. Source data (Bisleri_01) is read via DB_* above.

HISTORICAL_DB_USER=postgres
HISTORICAL_DB_PASSWORD=your_postgres_password_here
HISTORICAL_DB_HOST=localhost
HISTORICAL_DB_PORT=5432
HISTORICAL_DB_NAME=Bisleri_dashboard


# ── RPA Automation Dashboards (RPA_Automation DB) ────────────────
# Separate database for the RPA dashboard endpoints. All keys have safe
# defaults in config.py, so leave blank if the RPA feature is unused.

RPA_DB_USER=postgres
RPA_DB_PASSWORD=your_postgres_password_here
RPA_DB_HOST=localhost
RPA_DB_PORT=5432
RPA_DB_NAME=RPA_Automation


# ── IBM WatsonX OCR (co-packer image reading) ────────────────────
# Credentials for the WatsonX OCR service. Rotate the API key if leaked.

IBM_API_KEY=your_ibm_api_key
IBM_SERVICE_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=your_ibm_project_id
WATSONX_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct-fp8


# ── Co-Packer feature ────────────────────────────────────────────
COPACKER_FEATURE_ENABLED=true
COPACKER_IMAGE_PATH=/copacker_images
# ENABLE_FIELD_EDIT: co-packer field editing toggle (default false)
ENABLE_FIELD_EDIT=false


# Q18: persistent log file (logs/app.log, 5MB x5 rotation). Console logging
# always stays on; set true + restart to also write the file.
FILE_LOGGING=false

# Expose Swagger/API docs — keep false in production, true for local dev
ENABLE_DOCS=false


# ── Active Directory (AD) authentication ─────────────────────────
# Used only for a one-off connectivity test right now (scripts/test_ad_connection.py).
# Not yet wired into the main login flow.

AD_SERVER=ADSERVER2K19-HO
AD_PORT=636
AD_USE_SSL=true
AD_BIND_USER=gateentry@bisleri.co.in
AD_BIND_PASSWORD=your_ad_service_account_password_here
AD_DOMAIN=bisleri.co.in
