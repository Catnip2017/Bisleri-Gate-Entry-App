# bisleri-backend/.env.example
# ================================================================
# Bisleri Gate Entry App — Backend Configuration
# ================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit the real .env to Git (it is in .gitignore)
# ================================================================


# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection details for your bisleri_ecosystem database (the
# app's primary DB — gate pass, users, Fabric sync targets, etc.)

DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bisleri_ecosystem

# Source DB credentials for copying data from Bisleri_01 into bisleri_ecosystem
ECOSYSTEM_SOURCE_DB_HOST=localhost
ECOSYSTEM_SOURCE_DB_PORT=5432
ECOSYSTEM_SOURCE_DB_NAME=Bisleri_01
ECOSYSTEM_SOURCE_DB_PASSWORD=your_postgres_password_here


# ── Security / JWT ───────────────────────────────────────────────
# Used to sign and verify login tokens.
# Generate a strong key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then paste the output below — keep it secret, never share it.

SECRET_KEY=replace_this_with_a_long_random_secret_key

# JWT signing algorithm — do not change
ALGORITHM=HS256

# How long a login session stays valid (in minutes)
# 720 = 12 hours  |  1440 = 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── Vehicle/Load Dashboard (Bisleri_dashboard DB) ────────────────
# Separate historical/analytics database used by the dashboard's ETL and
# read endpoints. Source data (Bisleri_01) is read via DB_* above.

HISTORICAL_DB_USER=postgres
HISTORICAL_DB_PASSWORD=your_postgres_password_here
HISTORICAL_DB_HOST=localhost
HISTORICAL_DB_PORT=5432
HISTORICAL_DB_NAME=Bisleri_dashboard


# ── RPA Automation Dashboards (RPA_Automation DB) ────────────────
# Separate database for the RPA dashboard endpoints. All keys have safe
# defaults in config.py, so leave blank if the RPA feature is unused.

RPA_DB_USER=postgres
RPA_DB_PASSWORD=your_postgres_password_here
RPA_DB_HOST=localhost
RPA_DB_PORT=5432
RPA_DB_NAME=RPA_Automation


# ── IBM WatsonX OCR (co-packer image reading) ────────────────────
# Credentials for the WatsonX OCR service. Rotate the API key if leaked.

IBM_API_KEY=your_ibm_api_key
IBM_SERVICE_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=your_ibm_project_id
WATSONX_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct-fp8


# ── Co-Packer feature ────────────────────────────────────────────
COPACKER_FEATURE_ENABLED=true
COPACKER_IMAGE_PATH=/copacker_images
# ENABLE_FIELD_EDIT: co-packer field editing toggle (default false)
ENABLE_FIELD_EDIT=false


# Q18: persistent log file (logs/app.log, 5MB x5 rotation). Console logging
# always stays on; set true + restart to also write the file.
FILE_LOGGING=false

# Expose Swagger/API docs — keep false in production, true for local dev
ENABLE_DOCS=false


# ── Microsoft Fabric (gate pass Vendor/Customer/Fixed Asset masters) ──
# Two Lakehouse SQL analytics endpoints, same Azure AD App Registration
# (service principal) for both. FABRIC_SQL_ENDPOINT_1/FABRIC_LAKEHOUSE_1 =
# Customer Lakehouse; FABRIC_SQL_ENDPOINT_2/FABRIC_LAKEHOUSE_2 = ERP Lakehouse
# (Vendor/Fixed Asset).
# NEVER commit the real client secret — this file only holds placeholders.
# NOTE: the secret you paste in must be the App Registration's secret
# VALUE (Azure Portal -> Certificates & secrets), never the Secret ID —
# both look like random strings and the wrong one fails with
# AADSTS7000215 at connection time.

FABRIC_SQL_ENDPOINT_1=your-lakehouse-guid.datawarehouse.fabric.microsoft.com
FABRIC_LAKEHOUSE_1=bis_drvd
FABRIC_CLIENT_ID=your_app_registration_client_id
FABRIC_TENANT_ID=your_azure_ad_tenant_id
FABRIC_CLIENT_SECRET=your_app_registration_client_secret
FABRIC_CUSTOMER_TABLE=Customer_R2_qvd

# Second lakehouse — raw ERP tables (Vendor, Fixed Asset). Same App
# Registration/secret as above, different server + database.
FABRIC_SQL_ENDPOINT_2=your-erp-lakehouse-guid.datawarehouse.fabric.microsoft.com
FABRIC_LAKEHOUSE_2=Dataverse_productionse_cds2_workspace_unqe54b0c24fdebee119049002248d5c
FABRIC_ITEMS_TABLE=Inventtable
FABRIC_VENDOR_TABLE=vendtable
FABRIC_PARTY_TABLE=dirpartytable
FABRIC_ADDRESS_TABLE=logisticspostaladdress
FABRIC_ASSET_TABLE=assettable


# ── Active Directory (AD) authentication ─────────────────────────
# Used only for a one-off connectivity test right now (scripts/test_ad_connection.py).
# Not yet wired into the main login flow.

AD_SERVER=ADSERVER2K19-HO
AD_PORT=636
AD_USE_SSL=true
AD_BIND_USER=gateentry@bisleri.co.in
AD_BIND_PASSWORD=your_ad_service_account_password_here
AD_DOMAIN=bisleri.co.in


# ── Password policy (27 Nov 2026) ─────────────────────────────────
# false = only RECORD who needs a new password (Users list / Excel);
# true  = users whose password breaks the rule must set a new one at login.
# Old-format (Bisleri_01) passwords always get "Set a new password".
ENFORCE_PASSWORD_POLICY=false


# ── Documents section (27 Nov 2026) ───────────────────────────────
# Folders with the PDFs listed in the app. Copy a PDF in to publish it;
# move old versions into an "Archive" sub-folder (not listed).
# Name PSDs <Process_Name>_PSD_v<N>.pdf
PSD_FOLDER=D:\Bisleri Ops Hub\1_Documents\Process Solution Documents
GUIDES_FOLDER=D:\Bisleri Ops Hub\1_Documents\User Guides


# ── Alert email via Microsoft Entra / Graph (BACKEND ONLY) ────────
# NOT USED FOR NOW. Nothing is sent unless "Send alert email" is switched ON in
# User Management -> Security -> Settings (it is OFF by default) AND all four
# values below are filled in - so filling them in changes nothing by itself.
# Used by the nightly dormant-account check only. The secret lives ONLY here
# (never in the database, the app screens or the frontend .env).
#   GRAPH_TENANT_ID      Entra ID -> Overview -> Tenant ID
#   GRAPH_CLIENT_ID      App registration -> Application (client) ID
#   GRAPH_CLIENT_SECRET  App registration -> Certificates & secrets -> secret VALUE
#   ALERT_SENDER_MAILBOX mailbox the mail is sent from, e.g. no-reply@bisleri.co.in
#                        (the app needs the Graph "Mail.Send" application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
ALERT_SENDER_MAILBOX=
